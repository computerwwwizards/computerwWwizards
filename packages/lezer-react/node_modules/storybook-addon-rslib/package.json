{
  "name": "storybook-addon-rslib",
  "version": "3.6.1",
  "description": "Storybook addon for loading configuration of Rslib",
  "keywords": [
    "storybook",
    "storybook-addons",
    "rsbuild",
    "rspack",
    "rslib"
  ],
  "homepage": "https://storybook.rsbuild.rs",
  "bugs": {
    "url": "https://github.com/rstackjs/storybook-rsbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/storybook-rsbuild",
    "directory": "packages/addon-rslib"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./preset": "./dist/preset.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.3",
    "@rsbuild/core": "^2.2.11",
    "@rslib/core": "~1.0.2",
    "@types/node": "^22.0.0",
    "storybook": "10.6.0",
    "typescript": "^5.9.3",
    "storybook-builder-rsbuild": "3.6.1"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.5.0 || ^2.0.0-0",
    "@rslib/core": ">= 0.1.1 || >= 0.2 || >= 1.0.0-0",
    "storybook-builder-rsbuild": "^3.6.1"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "entries": [
      "./src/index.ts",
      "./src/preset.ts"
    ],
    "platform": "node"
  },
  "scripts": {
    "build": "rstack lib",
    "dev": "rstack lib --watch"
  }
}